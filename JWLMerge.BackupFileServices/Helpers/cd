    {
        ProgressMessage(" Independent media");

        foreach (var media in source.IndependentMedias)
        {
            var existing = destination.FindIndependentMediaByFilePath(media.FilePath);
            if (existing != null)
            {
                _translatedIndependentMediaIds.Add(media.IndependentMediaId, existing.IndependentMediaId);
            }
            else
            {
                InsertIndependentMedia(media, destination);
            }
        }
    }

    private void InsertIndependentMedia(IndependentMedia media, Database destination)
    {
        IndependentMedia newMedia = media.Clone();
        newMedia.IndependentMediaId = ++_maxIndependentMediaId;
        destination.IndependentMedias.Add(newMedia);

        _translatedIndependentMediaIds.Add(media.IndependentMediaId, newMedia.IndependentMediaId);
    }

    private void MergePlaylistItems(Database source, Database destination)
    {
        ProgressMessage(" Playlist items");

        foreach (var item in source.PlaylistItems)
        {
            var existing = destination.FindPlaylistItemByValues(item);
            if (existing != null)
            {
                _translatedPlaylistItemIds.Add(item.PlaylistItemId, existing.PlaylistItemId);
            }
            else
            {
                InsertPlaylistItem(item, destination);
            }
        }
    }

    private void InsertPlaylistItem(PlaylistItem item, Database destination)
    {
        PlaylistItem newItem = item.Clone();
        newItem.PlaylistItemId = ++_maxPlaylistItemId;

        if (item.ThumbnailFilePath != null)
        {
            var translatedMediaId = _translatedIndependentMediaIds.GetTranslatedId(0);
            // thumbnail is referenced by FilePath, not id - the file path itself is stable
            // across merges since InsertIndependentMedia clones the original FilePath value.
            newItem.ThumbnailFilePath = item.ThumbnailFilePath;
        }

        destination.PlaylistItems.Add(newItem);
        _translatedPlaylistItemIds.Add(item.PlaylistItemId, newItem.PlaylistItemId);
    }

    private void MergePlaylistItemIndependentMediaMaps(Database source, Database destination)
    {
        ProgressMessage(" Playlist item media maps");

        foreach (var map in source.PlaylistItemIndependentMediaMaps)
        {
            var playlistItemId = _translatedPlaylistItemIds.GetTranslatedId(map.PlaylistItemId);
            var independentMediaId = _translatedIndependentMediaIds.GetTranslatedId(map.IndependentMediaId);

            if (playlistItemId == 0 || independentMediaId == 0)
            {
